# 管理后台初始密码。迁移 D1 数据后，登录密码以数据库中已有的密码哈希为准。
ADMIN_PASSWORD=请替换为强密码

# Cookie 签名密钥；建议执行：openssl rand -hex 32
COOKIE_SECRET=请替换为至少32字节随机字符串

# 对外访问地址。使用反向代理或 OAuth 一键授权时务必填写，末尾不要加路径。
PUBLIC_URL=https://mail.example.com

# 宿主机映射端口
APP_PORT=8787
BIND_ADDRESS=127.0.0.1

# 可选：GPTMail API Key（也可以登录后在系统设置中填写）
# GPTMAIL_API_KEY=

# 注册邮箱分配 API（仅服务端 Secret；不要提交真实值）。
# 可使用独立 KR / US2 Key，也可用 REGISTRATION_API_KEYS JSON 扩展更多客户端。
# 建议每个值都使用：openssl rand -hex 32
# REGISTRATION_KR_API_KEY=
# REGISTRATION_US2_API_KEY=
# REGISTRATION_API_KEYS={"another-client":"replace-with-random-secret"}
# REGISTRATION_CLAIM_SECRET=
